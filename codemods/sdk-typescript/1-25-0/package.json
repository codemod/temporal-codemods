{
  "name": "temporalio-sdk-1-24-to-1-25",
  "version": "0.1.0",
  "description": "Migrate @temporalio/* TypeScript SDK from 1.24 to 1.25 (Nexus waitForStage + createEventGroup id-first)",
  "packageManager": "npm@10.x",
  "type": "module",
  "scripts": {
    "test": "npm run test:nexus && npm run test:event-group",
    "test:nexus": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/codemod.ts ./tests/nexus-update-wait-for-stage",
    "test:event-group": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/create-event-group-id-first.ts ./tests/create-event-group-id-first",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemod.com/jssg-types": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@jssg/utils": "latest"
  }
}
